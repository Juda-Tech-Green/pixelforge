{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "maxItems": 128,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "frameId": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "pose": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "facing": {
            "default": "right",
            "type": "string",
            "enum": [
              "right",
              "left"
            ]
          },
          "rotations": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": -3.141592653589793,
              "maximum": 3.141592653589793
            }
          },
          "rootTranslation": {
            "default": [
              0,
              0
            ],
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "targets": {
            "default": [],
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "root": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "middle": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "bend": {
                  "default": 1,
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": -1
                    }
                  ]
                }
              },
              "required": [
                "id",
                "root",
                "middle",
                "end",
                "position",
                "bend"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "facing",
          "rotations",
          "rootTranslation",
          "targets"
        ],
        "additionalProperties": false
      },
      "joints": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "additionalProperties": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "measurements": {
        "default": {},
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "attachments": {
        "default": {},
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "additionalProperties": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "bounds": {
        "type": "object",
        "properties": {
          "min": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "max": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "frameId",
      "pose",
      "joints",
      "measurements",
      "attachments"
    ],
    "additionalProperties": false
  }
}
