{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "loop": {
      "default": true,
      "type": "boolean"
    },
    "frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "keys": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "pose": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "time",
          "pose"
        ],
        "additionalProperties": false
      }
    },
    "contacts": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "root": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "middle": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "end": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "bend": {
            "default": 1,
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": -1
              }
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "endTime": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "tolerance": {
            "default": 0.25,
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "root",
          "middle",
          "end",
          "position",
          "bend",
          "start",
          "endTime",
          "tolerance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "loop",
    "frames",
    "durationMs",
    "keys",
    "contacts"
  ],
  "additionalProperties": false
}
