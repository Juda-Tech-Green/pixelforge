{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/urn:pixelforge:semantic-pose:1.0",
  "$defs": {
    "urn:pixelforge:semantic-pose:1.0": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "pixelforge-semantic-pose"
        },
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "rig": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "basePose": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "posture": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "neutral",
                "upright",
                "slumped",
                "lean_forward"
              ]
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "strength"
          ],
          "additionalProperties": false
        },
        "roles": {
          "type": "object",
          "properties": {
            "spine": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "chest": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "neck": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "leftArm": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "middle": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                }
              },
              "required": [
                "root",
                "middle",
                "end"
              ],
              "additionalProperties": false
            },
            "rightArm": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "middle": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                }
              },
              "required": [
                "root",
                "middle",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "hands": {
          "type": "object",
          "properties": {
            "left": {
              "type": "object",
              "properties": {
                "target": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "coordinate"
                        },
                        "space": {
                          "type": "string",
                          "const": "world"
                        },
                        "position": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            },
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "type",
                        "space",
                        "position"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "coordinate"
                        },
                        "space": {
                          "type": "string",
                          "const": "joint-local"
                        },
                        "joint": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        },
                        "position": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            },
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "type",
                        "space",
                        "joint",
                        "position"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "contact"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "object-anchor"
                        },
                        "object": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        },
                        "anchor": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        }
                      },
                      "required": [
                        "type",
                        "object",
                        "anchor"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "bend": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": -1
                    }
                  ]
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            },
            "right": {
              "type": "object",
              "properties": {
                "target": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "coordinate"
                        },
                        "space": {
                          "type": "string",
                          "const": "world"
                        },
                        "position": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            },
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "type",
                        "space",
                        "position"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "coordinate"
                        },
                        "space": {
                          "type": "string",
                          "const": "joint-local"
                        },
                        "joint": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        },
                        "position": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            },
                            {
                              "type": "number",
                              "minimum": -10000,
                              "maximum": 10000
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "type",
                        "space",
                        "joint",
                        "position"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "contact"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "object-anchor"
                        },
                        "object": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        },
                        "anchor": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                        }
                      },
                      "required": [
                        "type",
                        "object",
                        "anchor"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "bend": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": -1
                    }
                  ]
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "overrides": {
          "type": "object",
          "properties": {
            "rotations": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": -3.141592653589793,
                "maximum": 3.141592653589793
              }
            },
            "rootTranslation": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "facing": {
              "type": "string",
              "enum": [
                "right",
                "left"
              ]
            }
          },
          "additionalProperties": false
        },
        "attachment": {
          "type": "object",
          "properties": {
            "object": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "primaryHand": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            "grip": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "secondaryGrip": {
              "type": "object",
              "properties": {
                "hand": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "anchor": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "bend": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": -1
                    }
                  ]
                }
              },
              "required": [
                "hand",
                "anchor"
              ],
              "additionalProperties": false
            },
            "occlusion": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "sandwich"
                    },
                    "palmShapes": {
                      "minItems": 1,
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      }
                    },
                    "frontShapes": {
                      "minItems": 1,
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "palmShapes",
                    "frontShapes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "body-only"
                    },
                    "afterLayer": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                    }
                  },
                  "required": [
                    "type",
                    "afterLayer"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "object",
            "primaryHand",
            "grip",
            "occlusion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "version",
        "id",
        "rig"
      ],
      "additionalProperties": false
    }
  }
}
