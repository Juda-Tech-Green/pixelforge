{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/pixelforge-surface-regions",
  "$defs": {
    "pixelforge-surface-regions": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "pixelforge-surface-regions"
        },
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "surfaces": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "frame": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "layer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "regions": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "protected": {
                "default": [],
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "frame",
              "layer",
              "regions",
              "protected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "version",
        "id",
        "surfaces"
      ],
      "additionalProperties": false
    }
  }
}
