{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "loop": {
            "type": "boolean"
          },
          "frames": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frameId": {
                  "type": "string",
                  "minLength": 1
                },
                "durationMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "frameId",
                "durationMs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "loop",
          "frames"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "animations"
  ],
  "additionalProperties": false
}
