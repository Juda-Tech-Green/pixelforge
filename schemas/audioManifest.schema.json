{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "pixelforge-audio"
    },
    "assets": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "file": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "sampleRate": {
            "anyOf": [
              {
                "type": "number",
                "const": 22050
              },
              {
                "type": "number",
                "const": 44100
              },
              {
                "type": "number",
                "const": 48000
              }
            ]
          },
          "durationMs": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "key",
          "file",
          "source",
          "sampleRate",
          "durationMs"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "default": [],
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "animation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sound": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          }
        },
        "required": [
          "animation",
          "event",
          "sound"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "kind",
    "assets",
    "events"
  ],
  "additionalProperties": false
}
