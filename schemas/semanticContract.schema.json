{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "requiredAnimations": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredAnchors": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "actions": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "directions": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "separator": {
          "default": "-",
          "type": "string"
        }
      },
      "required": [
        "actions",
        "directions",
        "separator"
      ],
      "additionalProperties": false
    },
    "animations": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "requiredLayers": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layerPhases": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layer": {
                  "type": "string"
                },
                "minDistinctPhases": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "minVisibleEntries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "layer",
                "minDistinctPhases"
              ],
              "additionalProperties": false
            }
          },
          "durationsMs": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "warnEmpty": {
            "type": "boolean"
          },
          "baselineTolerance": {
            "type": "number",
            "minimum": 0
          },
          "boundsTolerance": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "exceptions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "animation": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "animation",
          "check",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
