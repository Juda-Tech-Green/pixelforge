{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@pixelforge/geometry": ["packages/geometry/src/index.ts"],
      "@pixelforge/audio-core": ["packages/audio-core/src/index.ts"],
      "@pixelforge/audio-exporters": ["packages/audio-exporters/src/index.ts"],
      "@pixelforge/core": ["packages/core/src/index.ts"],
      "@pixelforge/exporters": ["packages/exporters/src/index.ts"],
      "@pixelforge/phaser": ["packages/phaser/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "exclude": ["node_modules", "**/dist/**"],
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "examples/phaser/**/*.ts",
    "examples/phaser-playground/**/*.ts"
  ]
}
