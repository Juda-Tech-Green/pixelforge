{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "maxItems": 32,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "directory": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "scenePriorExampleExposure": {
        "type": "boolean"
      }
    },
    "required": [
      "directory",
      "model",
      "scenePriorExampleExposure"
    ],
    "additionalProperties": false
  }
}
