{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "controlled-algorithm-comparison"
    },
    "runtime": {
      "type": "string"
    },
    "character": {
      "type": "object",
      "properties": {
        "directPixels": {
          "type": "object",
          "properties": {
            "frames": {
              "type": "number",
              "minimum": 0
            },
            "maxBoneLengthError": {
              "type": "number",
              "minimum": 0
            },
            "meanBoneLengthError": {
              "type": "number",
              "minimum": 0
            },
            "maxFootTargetError": {
              "type": "number",
              "minimum": 0
            },
            "maxFootSlidePerStep": {
              "type": "number",
              "minimum": 0
            },
            "headWidthVariance": {
              "type": "number",
              "minimum": 0
            },
            "invalidJointRelationships": {
              "type": "number",
              "minimum": 0
            },
            "humanVisualQuality": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "renderMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "frames",
            "maxBoneLengthError",
            "meanBoneLengthError",
            "maxFootTargetError",
            "maxFootSlidePerStep",
            "headWidthVariance",
            "invalidJointRelationships",
            "humanVisualQuality",
            "renderMs"
          ],
          "additionalProperties": false
        },
        "geometry": {
          "type": "object",
          "properties": {
            "frames": {
              "type": "number",
              "minimum": 0
            },
            "maxBoneLengthError": {
              "type": "number",
              "minimum": 0
            },
            "meanBoneLengthError": {
              "type": "number",
              "minimum": 0
            },
            "maxFootTargetError": {
              "type": "number",
              "minimum": 0
            },
            "maxFootSlidePerStep": {
              "type": "number",
              "minimum": 0
            },
            "headWidthVariance": {
              "type": "number",
              "minimum": 0
            },
            "invalidJointRelationships": {
              "type": "number",
              "minimum": 0
            },
            "humanVisualQuality": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "renderMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "frames",
            "maxBoneLengthError",
            "meanBoneLengthError",
            "maxFootTargetError",
            "maxFootSlidePerStep",
            "headWidthVariance",
            "invalidJointRelationships",
            "humanVisualQuality",
            "renderMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "directPixels",
        "geometry"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "directOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometryOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directOcclusionViolations": {
          "type": "number",
          "minimum": 0
        },
        "geometryOcclusionViolations": {
          "type": "number",
          "minimum": 0
        },
        "projectionError": {
          "type": "number",
          "minimum": 0
        },
        "groundAnchorError": {
          "type": "number",
          "minimum": 0
        },
        "unexpectedOverlapViolations": {
          "type": "number",
          "minimum": 0
        },
        "humanCompositionQuality": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "directOrder",
        "geometryOrder",
        "directOcclusionViolations",
        "geometryOcclusionViolations",
        "projectionError",
        "groundAnchorError",
        "unexpectedOverlapViolations",
        "humanCompositionQuality"
      ],
      "additionalProperties": false
    },
    "crossModelEvaluated": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "kind",
    "runtime",
    "character",
    "scene",
    "crossModelEvaluated",
    "limitations"
  ],
  "additionalProperties": false
}
